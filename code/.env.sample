# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` must be git-ignored.
# Same variables as Session 1 — the governance layer is invisible to clients,
# which is the design goal.
# -----------------------------------------------------------------------------

APIM_GATEWAY_URL=https://apim-provdemo-vzl7w5xjytej4.azure-api.net

# Product subscription key. Which product you use changes the governance you
# get — team-cardiology gets 20k TPM and a violence threshold of 2;
# team-revenue-cycle gets 80k TPM and a threshold of 6. Same policy, same code,
# different posture. That is the isolation model in one sentence.
APIM_SUBSCRIPTION_KEY=

MODEL_DEPLOYMENT=gpt-5.6-sol
FOUNDRY_PROJECT=proj-personal-demo-usage
